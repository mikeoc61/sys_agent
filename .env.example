# Example env file for sys_agent.
#
# Copy this to one of the locations sys_agent searches and replace
# placeholders with real API keys. Lines starting with # are ignored.
# `export` prefix is optional. Shell-exported vars override these.
#
# Search order (first hit wins):
#   1. Path in $SYS_ENV_FILE (if set)
#   2. ./.env                           (project-local)
#   3. ~/.config/sys_agent/.env         (XDG, respects $XDG_CONFIG_HOME)
#   4. ~/.sys_agent.env                 (home dotfile)
#
# Typical install:
#   mkdir -p ~/.config/sys_agent
#   cp .env.example ~/.config/sys_agent/.env
#   chmod 600 ~/.config/sys_agent/.env
#   $EDITOR ~/.config/sys_agent/.env

# At least one of these is required
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Optional overrides ---

# Skip the interactive provider prompt at startup
# SYS_PROVIDER=anthropic

# Override default model strings
# SYS_OPENAI_MODEL=gpt-5.4-mini
# SYS_ANTHROPIC_MODEL=claude-sonnet-4-6

# Force-enable or disable color output (default: auto-detect TTY)
# SYS_COLOR=on
